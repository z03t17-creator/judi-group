# =============================================================================
# Copy these into Render → Web Service → Environment (do NOT commit real values).
# Generate APP_KEY locally:  cd laravel && php artisan key:generate --show
# =============================================================================

# --- required ---
APP_NAME=JUDI
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-SERVICE.onrender.com

APP_LOCALE=ckb
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# stderr so logs appear in the Render dashboard (not a vanished container file)
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# This app is MySQL-first (cPanel + local). Prefer an external MySQL.
# Render does not offer a free MySQL addon — use Aiven, PlanetScale, Railway,
# or any host, then fill the fields below.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Optional single URL instead of the split fields (Laravel reads DB_URL).
# If your host injects DATABASE_URL, the entrypoint maps it to DB_URL automatically.
# DB_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# If you must use Render/Neon/Supabase Postgres instead:
# DB_CONNECTION=pgsql
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@YOUR-DOMAIN.example
MAIL_FROM_NAME="${APP_NAME}"

# Web Push (alerts when the browser tab is closed — like Messenger)
VAPID_PUBLIC_KEY=BMsgeTTnVRCev2GBj5H_DdYeZEOA2PaDv6hFWYJKYxo9jvTUjV4CRNPzTahRV0oTkDhMvvkGJCiN9l_wjr6d9KQ
VAPID_PRIVATE_KEY=1w4L4tA0dr60f3j52mauoezz-q-oEvpxdoryPK1KDpY
VAPID_SUBJECT=mailto:admin@judi.local

# --- first deploy only (creates demo users). Remove after the first boot. ---
# RUN_SEED=true

# --- optional company / maps ---
JUDI_COMPANY_NAME=JUDI
JUDI_COMPANY_TAGLINE=NATURE • QUALITY • TRUST
JUDI_COMPANY_PHONES=0750 786 5782, 0770 133 6837
JUDI_COMPANY_ADDRESS=
JUDI_COMPANY_LEGAL_NAME=
JUDI_COMPANY_BRANCH=
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_DEFAULT_LAT=35.5558
GOOGLE_MAPS_DEFAULT_LNG=45.4351
GOOGLE_MAPS_DEFAULT_ZOOM=12

# --- optional Redis (not required; cache/session/queue default to database) ---
# REDIS_CLIENT=phpredis
# REDIS_HOST=
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# --- optional S3 (Render free disk is ephemeral — use S3 if uploads must persist) ---
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false
