# PostgreSQL
# Docker: npm run db:up  → postgresql://judi:judi@localhost:5432/judi?schema=public
# Local Prisma Postgres TCP (no Docker): npx prisma dev --detach --name judi
# postgresql://postgres:postgres@127.0.0.1:51214/template1?sslmode=disable&pgbouncer=true&connection_limit=5
# Or point this at Neon / Supabase.
DATABASE_URL="postgresql://judi:judi@localhost:5432/judi?schema=public"

# Auth.js (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET="replace-with-a-32-byte-secret"
AUTH_TRUST_HOST="true"

# Google Maps Embed API (optional — without it, maps still use Google Maps embed URLs)
# Enable "Maps Embed API" in Google Cloud Console, then paste the browser key:
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-maps-embed-api-key"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Web Push (required for stable production push across deploys)
# Generate with: node -e "const w=require('web-push'); console.log(w.generateVAPIDKeys())"
# If unset in development, the server auto-generates and stores keys in uploads/.vapid.json
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:admin@your-company.com"

# Production checklist (PWA + push):
# - Serve over HTTPS (secure context required for install + Notification + PushManager)
# - Set AUTH_TRUST_HOST=true behind a reverse proxy
# - Persist uploads/ (media + .vapid.json) across deploys, or set VAPID env keys
# - Confirm /manifest.webmanifest and /sw.js are publicly reachable
