# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.lnk
.cursor/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env / secrets — never commit real keys or production files
.env
.env.*
.env*.local
!.env.example
!laravel/.env.example
!laravel/.env.production.example
!laravel/.env.render.example
*.pem
auth.json
**/credentials.json
**/secrets.json

# media uploads (JPEG captures)
/uploads/*
!/uploads/.gitkeep

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo

# prisma
/prisma/*.db
/prisma/*.db-journal

# Laravel runtime / build artifacts (also covered by laravel/.gitignore)
laravel/.env
laravel/.env.backup
laravel/.env.production
laravel/vendor/
laravel/node_modules/
laravel/auth.json
laravel/storage/mysql/
laravel/storage/deploy/*.zip
laravel/storage/*.key
laravel/storage/logs/*.log
laravel/public/hot
laravel/public/storage
laravel/public/build
laravel/.phpunit.result.cache
laravel/.phpunit.cache/

# Docker local data (if you bind-mount anything here)
.docker-data/
